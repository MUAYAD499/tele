# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Telegram MTProto Userbot API Credentials
TELEGRAM_API_ID=25002565
TELEGRAM_API_HASH=9b6218bccd56051ca8ac7acb9eb71066
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=userbot
DATA_DIR=./data

# Web Dashboard Authentication
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-password
SECRET_KEY=generate-a-secure-random-jwt-secret-key

# Database Connection (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./data/database.db

# Matching & Forwarding Engine Rules
KEYWORD_THRESHOLD=1
FORWARD_DELAY=2
MONITOR_MODE=ALL

# System & Logging
LOG_LEVEL=INFO
TIMEZONE=Asia/Aden

